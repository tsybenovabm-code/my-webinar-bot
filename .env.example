# Скопируй этот файл в .env и заполни значения

# 1. Токен бота — получи у @BotFather в Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Твой Telegram ID — узнай у @userinfobot
#    Если админов несколько, через запятую: 123456,789012
ADMIN_IDS=123456789

# 3. Ссылка-приглашение в закрытый канал/группу с курсом
#    Создай в настройках канала: Управление → Пригласительные ссылки
COURSE_INVITE_LINK=https://t.me/+ВашаСсылка

# 4. Название курса (используется в тексте бота)
COURSE_CHANNEL_NAME=курс по SQL
